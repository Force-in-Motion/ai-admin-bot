# --- DATABASE (PostgreSQL) ---
# Для внешнего доступа (DBeaver) используй порт 1010
# Внутри Docker приложение идет по этому URL:
DB_URL=postgresql+asyncpg://gsa:0502@db:5432/admin_bot
DB_USER=gsa
DB_PASSWORD=0502
DB_NAME=admin_bot
DB_PORT=5432
DB_ECHO=True

# --- REDIS (Caching & Celery Backend) ---
# Внутри Docker порт 6379. База 0 для кеша, база 1 для Celery
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_URL=redis://redis:6379/0
CELERY_BACKEND_URL=redis://redis:6379/1

# --- RABBITMQ (Broker) ---
# Внутри Docker порт 5672
RMQ_USER=gsa
RMQ_PASS=0502
RMQ_HOST=rabbitmq
RMQ_PORT=5672
CELERY_BROKER_URL=amqp://gsa:0502@rabbitmq:5672//

# --- CELERY CONFIG ---
CELERY_BEAT_INTERVAL=60
WORKER_POOL=prefork
WORKER_CONCURRENCY=4
TASK_CREATE_MISSING_QUEUES=True
TASK_SERIALIZER=json
RESULT_SERIALIZER=json
ACCEPT_CONTENT=json
TIMEZONE=UTC

# --- JWT AUTH ---
JWT_PRIVATE_KEY=certs/private.pem
JWT_PUBLIC_KEY=certs/public.pem
JWT_ALGORITHM=RS256
JWT_TOKEN_TYPE=Bearer
JWT_ACCESS_TOKEN_EXPIRE=120
JWT_REFRESH_TOKEN_EXPIRE=43200
JWT_ACCESS_NAME=access
JWT_REFRESH_NAME=refresh

# --- AI ---
GEMINI_API_KEY=AIzaSyB75eFkOoCdvkVMS7bJnLOjLTZ5dYtbe-8